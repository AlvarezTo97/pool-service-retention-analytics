        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "range",
                    "options": {
                      "from": -100000,
                      "to": -0.0001,
                      "result": {
                        "text": "Below minimum",
                        "color": "red",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 0,
                      "to": 100000,
                      "result": {
                        "text": "OK",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
