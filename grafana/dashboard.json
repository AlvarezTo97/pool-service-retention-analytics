      "title": "Vehicle stock vs minimum level",
      "description": "Check this before ordering: only items below minimum need restocking.",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "grafana-googlesheets-datasource",
        "uid": "${DS_GOOGLE_SHEETS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-googlesheets-datasource",
            "uid": "${DS_GOOGLE_SHEETS}"
          },
          "spreadsheet": "YOUR_SPREADSHEET_ID",
          "range": "'Vehicle Inventory'!A:E",
