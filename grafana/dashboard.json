        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "cancellations"
                }
              },
              "operator": "/",
              "right": {
                "matcher": {
                  "id": "byName",
                  "options": "active_start"
                }
              }
            },
            "alias": "cancel_rate",
            "replaceFields": true
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
