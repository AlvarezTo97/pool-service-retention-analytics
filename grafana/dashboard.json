{
  "title": "Pool Service Co. – Retention & Growth Dashboard",
  "tags": [
    "retention"
  ],
  "timezone": "utc",
  "time": {
    "from": "now-1y",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "## Pool service company: retention & growth\nData comes from a Google Sheet and refreshes every 5 minutes. Seasonal pauses are tracked separately and are not counted as cancellations."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "New customers",
      "description": "Jan–Dec 2026",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-googlesheets-datasource",
        "uid": "${DS_GOOGLE_SHEETS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-googlesheets-datasource",
            "uid": "${DS_GOOGLE_SHEETS}"
          },
          "spreadsheet": "YOUR_SPREADSHEET_ID",
          "range": "'Monthly Customers'!A:E",
          "cacheDurationSeconds": 300,
          "useTimeFilter": false
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "any",
            "filters": [
              {
                "fieldName": "month",
                "config": {
                  "id": "isNull",
                  "options": {}
                }
              }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "/^new_customers$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
