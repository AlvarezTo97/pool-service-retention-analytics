                }
              }
            },
            "alias": "Status",
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "vehicle": 0,
              "item": 1,
              "on_hand": 2,
              "min_level": 3,
              "unit": 4,
              "Status": 5
            },
            "renameByName": {
              "vehicle": "Vehicle",
              "item": "Item",
              "on_hand": "On hand",
              "min_level": "Minimum",
              "unit": "Unit"
