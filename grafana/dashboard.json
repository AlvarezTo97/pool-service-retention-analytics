    {
      "id": 4,
      "type": "stat",
      "title": "Net customer change",
      "description": "New minus cancelled",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-googlesheets-datasource",
        "uid": "${DS_GOOGLE_SHEETS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-googlesheets-datasource",
            "uid": "${DS_GOOGLE_SHEETS}"
          },
          "spreadsheet": "YOUR_SPREADSHEET_ID",
          "range": "'Monthly Customers'!A:E",
          "cacheDurationSeconds": 300,
          "useTimeFilter": false
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "any",
            "filters": [
              {
                "fieldName": "month",
                "config": {
                  "id": "isNull",
                  "options": {}
                }
              }
            ]
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "new_customers"
                }
              },
              "operator": "-",
              "right": {
                "matcher": {
                  "id": "byName",
                  "options": "cancellations"
                }
              }
            },
            "alias": "net_change",
            "replaceFields": true
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "/^net_change$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Avg monthly cancellation rate",
      "description": "Cancellations ÷ active at month start",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-googlesheets-datasource",
        "uid": "${DS_GOOGLE_SHEETS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-googlesheets-datasource",
            "uid": "${DS_GOOGLE_SHEETS}"
          },
          "spreadsheet": "YOUR_SPREADSHEET_ID",
          "range": "'Monthly Customers'!A:E",
          "cacheDurationSeconds": 300,
          "useTimeFilter": false
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "any",
            "filters": [
              {
                "fieldName": "month",
                "config": {
                  "id": "isNull",
                  "options": {}
                }
              }
            ]
