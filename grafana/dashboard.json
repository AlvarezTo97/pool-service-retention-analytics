      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-googlesheets-datasource",
            "uid": "${DS_GOOGLE_SHEETS}"
          },
          "spreadsheet": "YOUR_SPREADSHEET_ID",
          "range": "'Monthly Customers'!A:E",
          "cacheDurationSeconds": 300,
          "useTimeFilter": false
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "any",
            "filters": [
              {
                "fieldName": "month",
                "config": {
                  "id": "isNull",
                  "options": {}
                }
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "active_start": true
            },
            "renameByName": {
              "cancellations": "Cancellations",
              "new_customers": "New customers",
              "seasonal_pauses": "Seasonal pauses"
            }
          }
        }
      ],
      "options": {
        "xField": "month",
        "orientation": "vertical",
        "groupWidth": 0.75,
        "barWidth": 0.9,
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "top",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        },
        "xTickLabelSpacing": 0
