    {
      "id": 7,
      "type": "stat",
      "title": "Truck items below minimum",
      "description": "From the vehicle stock log",
      "gridPos": {
        "x": 20,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-googlesheets-datasource",
        "uid": "${DS_GOOGLE_SHEETS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-googlesheets-datasource",
            "uid": "${DS_GOOGLE_SHEETS}"
          },
          "spreadsheet": "YOUR_SPREADSHEET_ID",
          "range": "'Vehicle Inventory'!A:E",
          "cacheDurationSeconds": 300,
          "useTimeFilter": false
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "any",
            "filters": [
              {
                "fieldName": "vehicle",
                "config": {
                  "id": "isNull",
                  "options": {}
                }
              }
            ]
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "on_hand"
                }
              },
              "operator": "-",
              "right": {
                "matcher": {
                  "id": "byName",
                  "options": "min_level"
                }
              }
            },
            "alias": "gap",
            "replaceFields": true
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "any",
            "filters": [
              {
                "fieldName": "gap",
                "config": {
                  "id": "lower",
                  "options": {
                    "value": 0
                  }
                }
              }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
