    {
      "id": 8,
      "type": "barchart",
      "title": "New customers vs cancellations by month",
      "description": "Seasonal pauses are shown separately so winter closures don't inflate churn.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-googlesheets-datasource",
